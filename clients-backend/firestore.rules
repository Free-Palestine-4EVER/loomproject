rules_version = '2';

// LOOM Clients — Firestore security rules.
//
// THE MODEL IN ONE LINE: no client SDK may read or write anything, ever.
//
// This looks paranoid and is actually the whole design. The client iOS app
// does NOT talk to Firestore — it talks to the HTTPS API in functions/, which
// runs the engine's own clientapi.mjs and returns payloads built by explicit
// field-picking. That indirection exists because Firestore rules can gate
// access to a DOCUMENT but cannot project FIELDS: a rule that let a client read
// its own posts would hand it the whole post record, including qaSeconds,
// generationCostJod, marginPct and the rest of PRIVACY_FORBIDDEN_KEYS. LOOM's
// cost and margin data sits in the same documents as the captions.
//
// So the correct rule is "deny everything" and route all access through the
// Admin SDK, which bypasses these rules by design. If someone later wants the
// app to read Firestore directly for speed, that is not a rules change — it
// needs a separate collection holding pre-projected client-safe copies, and
// this comment is the reason.
//
// `operatorcodes` deserves its own mention: it holds PLAINTEXT login codes for
// the operator to read out (see the long note in functions/index.mjs). It must
// never be readable by a client SDK caller. The catch-all below covers it; it
// is called out explicitly here so nobody adds a convenience exception later.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------
    // blip — a second, independent product on this same Firebase project.
    // File-transfer accounts/devices/quota only; the actual file bytes go
    // peer-to-peer over WebRTC and never touch this backend.
    //
    // These four `match` blocks are SIBLINGS of the catch-all above, not a
    // replacement for it. Firestore evaluates rules as a UNION across every
    // matching path: a request under /blipusers/{uid} is still matched by
    // the recursive catch-all (which denies), but ALSO matched by the more
    // specific block below (which can allow) — the union of "allow" wins.
    // This is the standard, correct way to carve out an exception under a
    // deny-all root; it does not weaken the catch-all for any existing LOOM
    // portal collection (clients, posts, invoices, conversations,
    // operatorcodes, etc.), which have no matching specific block and so
    // stay fully denied.
    //
    // All four collections are server-write-only: every write goes through
    // the `blip` Cloud Function using the Admin SDK, which bypasses these
    // rules entirely. That is deliberate — it is what keeps `plan` and the
    // daily quota counters un-forgeable by a client. Clients may only ever
    // read their own documents, identified by Firebase Auth's `request.auth`
    // (NOT the portal's custom Bearer scheme).

    match /blipusers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /blipdevices/{deviceId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /bliptransfers/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /blipquota/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
