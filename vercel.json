{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*).usdz",
      "headers": [
        {
          "key": "Content-Type",
          "value": "model/vnd.usdz+zip"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/loom-table.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/_next/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/360/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, must-revalidate"
        }
      ]
    },
    {
      "source": "/loomina/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/loomina/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/360",
      "destination": "/360/",
      "permanent": false
    },
    {
      "source": "/360/house",
      "destination": "/360/house/",
      "permanent": false
    },
    {
      "source": "/qrmenu",
      "destination": "/qrmenu/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sotg/",
      "destination": "/sotg/index.html"
    },
    {
      "source": "/sotg",
      "destination": "/sotg/index.html"
    },
    {
      "source": "/lexus/",
      "destination": "/lexus/index.html"
    },
    {
      "source": "/lexus",
      "destination": "/lexus/index.html"
    },
    {
      "source": "/360/",
      "destination": "https://loom-360.web.app/index.html?v=2"
    },
    {
      "source": "/360/house/",
      "destination": "https://loom-360.web.app/house/index.html?v=2"
    },
    {
      "source": "/360/:path*",
      "destination": "https://loom-360.web.app/:path*?v=2"
    },
    {
      "source": "/qrmenu/",
      "destination": "https://loom-qrmenu.web.app/qrmenu/index.html"
    },
    {
      "source": "/qrmenu/:path*",
      "destination": "https://loom-qrmenu.web.app/qrmenu/:path*"
    },
    {
      "source": "/loomina/",
      "destination": "/loomina/index.html"
    },
    {
      "source": "/loomina",
      "destination": "/loomina/index.html"
    }
  ]
}
